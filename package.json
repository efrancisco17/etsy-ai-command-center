{
  "name": "etsy-ai-command-center",
  "version": "1.0.0",
  "description": "AI-powered Etsy automation platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc --outDir dist",
    "build:frontend": "vite build",
    "start": "node dist/index.js",
    "db:init": "ts-node src/backend/db/init.ts",
    "db:reset": "ts-node src/backend/db/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/node": "^3.0.0",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "openai": "^7.27.0",
    "pg": "8.11.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "4.2.1",
    "concurrently": "8.2.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.3.6",
    "tsx": "4.7.0",
    "typescript": "5.3.3",
    "vite": "5.0.7"
  }
}
